{
  "name": "barrage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"next dev --turbopack\" \"ts-node-dev --respawn --transpile-only server/index.ts\"",
    "dev:f": "next dev --turbopack",
    "dev:b": "ts-node-dev --respawn --transpile-only server/index.ts",
    "build": "concurrently \"next build --turbopack\" \"tsc --project server/tsconfig.json\"",
    "start": "concurrently \"next start\" \"node server/dist/index.js\"",
    "start:f": "next start",
    "start:b": "node server/dist/index.js",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "dependencies": {
    "next": "15.5.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "express": "^4.18.2",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "sass": "^1.93.2",
    "typescript": "^5",
    "ts-node-dev": "^2.0.0",
    "concurrently": "^8.2.0",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.3"
  }
}
